@{
    ViewBag.Title = "Stock App";
}
@model StockTrade

<div class="header"> <h1>Stock App</h1> </div>
<form asp-controller="Trade" asp-action="Index" method="post" class="trade" >
    <div class="page-content">
        <div class="stock center-box">
            <div class="box white-back">
                <div class="flex" style="justify-content: space-between; align-items: center;"> <div> <h1 class="stock-title">@Model.StockName</h1> <span class="text-grey">@Model.StockSymbol</span> </div> <h1 class="stock-price text-green">$@Model.Price</h1> </div>
                <input asp-for="StockName" type="hidden" name="StockName" value="@Model.StockName" />
                <span asp-validation-for="StockName" class="text-red"></span>
                <input asp-for="StockSymbol" type="hidden" name="StockSymbol" value="@Model.StockSymbol" />
                <span asp-validation-for="StockSymbol" class="text-red"></span>
                <input asp-for="Price" type="hidden" name="Price" value="@Model.Price" />
            </div>

            <div class="box trading-panel">
                <h2 class="text-blue">Trade @Model.StockSymbol</h2>

                <div class="mt">
                    <label class="form-label">Quantity</label>
                    <input asp-for="Quantity" type="number" name="Quantity" class="form-input" placeholder="Enter quantity" min="1" />
                    <span asp-validation-for="Quantity" class="text-red"></span>
                </div>

                <div class="button-panel">
                    <button type="submit" formaction="~/Trade/BuyOrder" class="button button-green-back trading-button">Buy</button>
                    <button type="submit" formaction="~/Trade/SellOrder" class="button button-red-back trading-button">Sell</button>
                    <div asp-validation-summary="All" class="text-red"></div>

                </div>
            </div>
        </div>
    </div>
    
       
   

</form>
<div class="footer-content"> Stock App &copy; @DateTime.Now.Year </div>
@section scripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js" asp-fallback-test="window.jQuery" asp-fallback-src="~/jquery.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.4/jquery.validate.min.js" asp-fallback-test="window.jQuery.validator" asp-fallback-src="~/jquery.validate.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js" asp-fallback-test="window.jQuery.validator.unobstrusive" asp-fallback-src="~/jquery.validate.unobtrusive.min.js"></script>
}