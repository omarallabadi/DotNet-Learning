                DateAndTimeOfOrder = DateTime.Now,
                Quantity = 100001,
                Price = 100
            };

            // Act & Assert
            await Assert.ThrowsAsync<ArgumentException>(
                () => _StockServices.CreateBuyOrder(buyOrderRequest));
        }

